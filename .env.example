# ---------------------------------------------------------------------------
# SERVER-ONLY settings for the member invitation email (Vercel function /api/send-invite).
# Add these in Vercel -> Settings -> Environment Variables. NEVER put VITE_ in front
# of them (VITE_ values are public and end up inside the app).
# ---------------------------------------------------------------------------
# Must be the SAME email as ownerEmail() in firestore.rules (all lowercase).
# Used by the server (invite email check) AND read at build time so the app shows the Owner view
# for this account. It is an address, not a secret. Redeploy after changing it.
OWNER_EMAIL=bakshistock@gmail.com
# The address members should open, no trailing slash (your Vercel address or custom domain).
APP_URL=https://your-app-name.vercel.app
# Gmail: turn ON 2-Step Verification, then Google Account -> Security -> App passwords -> create one.
# SMTP_PASS must be that 16-letter App Password (NOT the normal Gmail password). Spaces are ignored.
# SMTP_USER is the Gmail address that created it (defaults to OWNER_EMAIL if left out).
SMTP_USER=bakshistock@gmail.com
SMTP_PASS=16-letter-app-password
# Optional (defaults shown): SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
# Optional: MAIL_FROM="Mayapuri Stock" <bakshistock@gmail.com>
